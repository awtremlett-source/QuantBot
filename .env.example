# --- Trading 212 (DEMO / practice account ONLY for now) ---
# NOTE (to verify): the prior code assumed KEY:SECRET Basic auth, but the
# current official T212 public API uses a single api-key header. Confirm
# against the official docs before first use, then prune the unused name.
T212_API_KEY=
T212_API_SECRET=
T212_ENV=demo

